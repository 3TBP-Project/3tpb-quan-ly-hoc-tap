# Sao chép tệp này thành ".env" rồi điền giá trị thật. KHÔNG commit tệp ".env".
# Vite chỉ đọc các biến bắt đầu bằng VITE_ và đưa chúng vào mã chạy trên trình duyệt,
# vì vậy tuyệt đối không đặt mật khẩu, khóa bí mật hay chuỗi kết nối CSDL ở đây.

# Địa chỉ gốc của REST API (backend Express). Thống nhất giá trị với TV2.
VITE_API_URL=http://localhost:5000

# Tạm thời dùng dữ liệu giả cho danh sách khóa học khi backend chưa có /api/courses.
# Đặt false để gọi API thật.
VITE_USE_MOCK=true

# (Tùy chọn) Số khóa mỗi trang, mặc định 9. Đặt nhỏ (ví dụ 3) để thử phân trang với dữ liệu giả.
# VITE_PAGE_SIZE=3
